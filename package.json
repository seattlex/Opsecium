{
  "name": "opsecium",
  "productName": "Opsecium",
  "version": "0.1.1",
  "description": "Chromium browser with full user agent control, VPN integration and the telemetry stripped out",
  "license": "MIT",
  "author": "seattlex <kaspersolo3010@gmail.com>",
  "homepage": "https://github.com/seattlex/Opsecium",
  "repository": {
    "type": "git",
    "url": "https://github.com/seattlex/Opsecium.git"
  },
  "bugs": {
    "url": "https://github.com/seattlex/Opsecium/issues"
  },
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js",
    "smoke": "electron test/smoke.js",
    "smoke:disk": "electron test/confidentiality.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.opsecium.browser",
    "productName": "Opsecium",
    "copyright": "Copyright (c) 2026 seattlex",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "electronDownload": {
      "cache": ".cache/electron"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Network;WebBrowser",
      "synopsis": "Chromium browser with user agent control and VPN integration",
      "desktop": {
        "entry": {
          "Name": "Opsecium",
          "StartupWMClass": "Opsecium"
        }
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Opsecium",
      "uninstallDisplayName": "Opsecium",
      "deleteAppDataOnUninstall": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "darkModeSupport": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0"
      ]
    }
  }
}
